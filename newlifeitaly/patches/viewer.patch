+
+class LLButton;
+class LLMediaCtrl;
+
+class LLFloaterNLIMedia final : public LLFloater, public LLViewerMediaObserver
+{
+public:
+    LLFloaterNLIMedia(const LLSD& key);
+    ~LLFloaterNLIMedia() override;
+
+    bool postBuild() override;
+    void onOpen(const LLSD& key) override;
+    void draw() override;
+    void handleMediaEvent(LLPluginClassMedia* self, EMediaEvent event) override;
+
+    static void toggleCamera(const LLSD& userdata);
+    static void toggleMicrophone(const LLSD& userdata);
