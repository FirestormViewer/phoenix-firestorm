index 00000000..8c295ddb
--- /dev/null
+++ b/indra/newview/llfloaternlimedia.cpp
@@ -0,0 +1,394 @@
+/**
+ * @file llfloaternlimedia.cpp
+ * @brief NewLifeItaly region-scoped camera and microphone panel.
+ */
+
+#include "llviewerprecompiledheaders.h"
+
+#include "llfloaternlimedia.h"
+
+#include "llagent.h"
+#include "llagentdata.h"
+#include "llbase64.h"
+#include "llbutton.h"
+#include "llcorehttputil.h"
+#include "llcoros.h"
+#include "llfloaterreg.h"
+#include "llmediactrl.h"
+#include "llpluginclassmedia.h"
+#include "lluri.h"
+#include "llviewercontrol.h"
+#include "llviewerregion.h"
+
+#include <boost/algorithm/string.hpp>
+
+bool LLFloaterNLIMedia::sCameraDesired = false;
+bool LLFloaterNLIMedia::sMicrophoneDesired = false;
+bool LLFloaterNLIMedia::sCameraOn = false;
+bool LLFloaterNLIMedia::sMicrophoneOn = false;
+
+LLFloaterNLIMedia::LLFloaterNLIMedia(const LLSD& key)
+: LLFloater(key)
+{
+}
+
+LLFloaterNLIMedia::~LLFloaterNLIMedia()
+{
+    if (mBrowser)
+    {
+        mBrowser->remObserver(this);
+    }
+}
+
+bool LLFloaterNLIMedia::postBuild()
+{
+    mBrowser = getChild<LLMediaCtrl>("media_browser");
+    mCameraButton = getChild<LLButton>("camera_btn");
+    mMicrophoneButton = getChild<LLButton>("microphone_btn");
+
+    mBrowser->addObserver(this);
+    mCameraButton->setCommitCallback(boost::bind(&LLFloaterNLIMedia::onCameraClicked, this));
+    mMicrophoneButton->setCommitCallback(boost::bind(&LLFloaterNLIMedia::onMicrophoneClicked, this));
+    getChild<LLButton>("retry_btn")->setCommitCallback(boost::bind(&LLFloaterNLIMedia::onRetryClicked, this));
+
+    updateControls();
+    return true;
+}
+
+void LLFloaterNLIMedia::onOpen(const LLSD& key)
+{
+    LLFloater::onOpen(key);
+    ensureLoaded();
+}
+
+void LLFloaterNLIMedia::draw()
+{
+    if (mRegionCheckTimer.hasExpired())
+    {
+        mRegionCheckTimer.setTimerExpirySec(1.0f);
+        const LLUUID current_region = gAgent.getRegion() ? gAgent.getRegion()->getRegionID() : LLUUID::null;
+        if (current_region != mRegionId)
+        {
+            // Never carry a publication from one region into another.
+            sCameraDesired = false;
+            sMicrophoneDesired = false;
+            sCameraOn = false;
+            sMicrophoneOn = false;
+            mCameraAllowed = false;
+            mMicrophoneAllowed = false;
+            mRegionId = current_region;
+            mBootstrapInFlight = false;
+            requestBootstrap();
+            updateControls();
+        }
+    }
+
+    LLFloater::draw();
+}
+
+void LLFloaterNLIMedia::toggleCamera(const LLSD& userdata)
+{
+    sCameraDesired = !sCameraDesired;
+    LLFloaterNLIMedia* floater = LLFloaterReg::showTypedInstance<LLFloaterNLIMedia>("nli_media");
+    if (floater)
+    {
+        floater->sendDesiredState();
+        floater->updateControls();
+    }
+}
+
+void LLFloaterNLIMedia::toggleMicrophone(const LLSD& userdata)
+{
+    sMicrophoneDesired = !sMicrophoneDesired;
+    LLFloaterNLIMedia* floater = LLFloaterReg::showTypedInstance<LLFloaterNLIMedia>("nli_media");
+    if (floater)
+    {
+        floater->sendDesiredState();
+        floater->updateControls();
+    }
+}
+
+bool LLFloaterNLIMedia::isCameraOn(const LLSD& userdata)
+{
+    return sCameraDesired;
+}
+
+bool LLFloaterNLIMedia::isMicrophoneOn(const LLSD& userdata)
+{
+    return sMicrophoneDesired;
+}
+
+bool LLFloaterNLIMedia::isMediaAvailable(const LLSD& userdata)
+{
+    return gAgent.isInitialized() && gAgent.getRegion() && !gSavedSettings.getString("NewLifeItalyMediaURL").empty();
+}
+
+void LLFloaterNLIMedia::onCameraClicked()
+{
+    sCameraDesired = !sCameraDesired;
+    sendDesiredState();
+    updateControls();
+}
+
+void LLFloaterNLIMedia::onMicrophoneClicked()
+{
+    sMicrophoneDesired = !sMicrophoneDesired;
+    sendDesiredState();
+    updateControls();
+}
+
+void LLFloaterNLIMedia::onRetryClicked()
+{
+    mPageReady = false;
+    mBootstrapInFlight = false;
+    mCameraAllowed = false;
+    mMicrophoneAllowed = false;
+    mBrowser->navigateTo(gSavedSettings.getString("NewLifeItalyMediaURL"), "text/html");
+    updateControls();
+}
+
+void LLFloaterNLIMedia::ensureLoaded()
+{
+    if (!mBrowser || !isMediaAvailable(LLSD()))
+    {
+        return;
+    }
+
+    mRegionId = gAgent.getRegion()->getRegionID();
+    const std::string media_url = gSavedSettings.getString("NewLifeItalyMediaURL");
+    if (mBrowser->getCurrentNavUrl().empty())
+    {
+        mBrowser->navigateTo(media_url, "text/html");
+    }
+}
+
+void LLFloaterNLIMedia::requestBootstrap()
+{
+    if (!mPageReady || !mBrowser || !gAgent.getRegion() || mBootstrapInFlight)
+    {
+        return;
+    }
+
+    std::string endpoint = gSavedSettings.getString("NewLifeItalyMediaURL");
+    while (!endpoint.empty() && endpoint.back() == '/')
+    {
+        endpoint.pop_back();
+    }
+    endpoint += "/api/native-bootstrap";
+
+    mBootstrapInFlight = true;
+    getChild<LLUICtrl>("status_text")->setValue(getString("authenticating_text"));
+    const LLUUID region_id = gAgent.getRegion()->getRegionID();
+    LLCoros::instance().launch(
+        "NewLifeItalyNativeBootstrap",
+        boost::bind(&LLFloaterNLIMedia::requestBootstrapCoro,
+                    gAgentID,
+                    gAgent.getSecureSessionID(),
+                    region_id,
+                    endpoint));
+}
+
+void LLFloaterNLIMedia::requestBootstrapCoro(const LLUUID& agent_id,
+                                             const LLUUID& secure_session_id,
+                                             const LLUUID& region_id,
+                                             const std::string& endpoint)
+{
+    LLCoreHttpUtil::HttpCoroutineAdapter::ptr_t http_adapter =
+        std::make_shared<LLCoreHttpUtil::HttpCoroutineAdapter>(
+            "NewLifeItalyNativeBootstrap",
+            LLCore::HttpRequest::DEFAULT_POLICY_ID);
+    LLCore::HttpRequest::ptr_t http_request = std::make_shared<LLCore::HttpRequest>();
+    LLCore::HttpHeaders::ptr_t headers = std::make_shared<LLCore::HttpHeaders>();
+    headers->append("Accept", "application/json");
+    headers->append("Content-Type", "application/json");
+
+    LLSD body;
+    body["agent_id"] = agent_id;
+    body["secure_session_id"] = secure_session_id;
+    body["region_id"] = region_id;
+
+    LLSD result = http_adapter->postJsonAndSuspend(http_request, endpoint, body, headers);
+    const LLSD http_results = result[LLCoreHttpUtil::HttpCoroutineAdapter::HTTP_RESULTS];
+    const LLCore::HttpStatus status =
+        LLCoreHttpUtil::HttpCoroutineAdapter::getStatusFromLLSD(http_results);
+
+    std::string bootstrap_token;
+    std::string error_message;
+    if (status && result.has("bootstrapToken"))
+    {
+        bootstrap_token = result["bootstrapToken"].asString();
+    }
+    else
+    {
+        error_message = status.toString();
+        if (result.has("error"))
+        {
+            error_message = result["error"].asString();
+        }
+    }
+
+    LLFloaterNLIMedia* floater =
+        LLFloaterReg::findTypedInstance<LLFloaterNLIMedia>("nli_media");
+    if (floater)
+    {
+        floater->receiveBootstrap(region_id, bootstrap_token, error_message);
+    }
+}
+
+void LLFloaterNLIMedia::receiveBootstrap(const LLUUID& region_id,
+                                         const std::string& bootstrap_token,
+                                         const std::string& error_message)
+{
+    if (region_id != mRegionId)
+    {
+        return;
+    }
+
+    mBootstrapInFlight = false;
+    if (!error_message.empty() || bootstrap_token.empty())
+    {
+        getChild<LLUICtrl>("status_text")->setValue(getString("auth_error_text"));
+        updateControls();
+        return;
+    }
+
+    const std::string encoded = LLBase64::encode(
+        reinterpret_cast<const U8*>(bootstrap_token.data()),
+        bootstrap_token.size());
+    if (mBrowser && mPageReady)
+    {
+        if (LLPluginClassMedia* plugin = mBrowser->getMediaPlugin())
+        {
+            plugin->executeJavaScript(
+                "window.NewLifeItalyViewer&&window.NewLifeItalyViewer.bootstrapFromTokenBase64('" +
+                encoded + "'," +
+                (sCameraDesired ? "true" : "false") + "," +
+                (sMicrophoneDesired ? "true" : "false") + ");");
+        }
+    }
+}
+
+void LLFloaterNLIMedia::sendDesiredState()
+{
+    ensureLoaded();
+    if (!mPageReady || !mBrowser)
+    {
+        return;
+    }
+
+    if (LLPluginClassMedia* plugin = mBrowser->getMediaPlugin())
+    {
+        plugin->executeJavaScript(llformat(
+            "window.NewLifeItalyViewer&&window.NewLifeItalyViewer.setDesiredState(%s,%s);",
+            sCameraDesired ? "true" : "false",
+            sMicrophoneDesired ? "true" : "false"));
+    }
+}
+
+void LLFloaterNLIMedia::handleMediaEvent(LLPluginClassMedia* self, EMediaEvent event)
+{
+    switch (event)
+    {
+        case MEDIA_EVENT_LOCATION_CHANGED:
+            if (!isAllowedLocation(self->getLocation()))
+            {
+                mPageReady = false;
+                mBrowser->navigateStop();
+                mBrowser->navigateTo(gSavedSettings.getString("NewLifeItalyMediaURL"), "text/html");
+            }
+            break;
+
+        case MEDIA_EVENT_NAVIGATE_BEGIN:
+            mPageReady = false;
+            getChild<LLUICtrl>("status_text")->setValue(getString("loading_text"));
+            updateControls();
+            break;
+
+        case MEDIA_EVENT_NAVIGATE_COMPLETE:
+            if (isAllowedLocation(self->getNavigateURI()))
+            {
+                mPageReady = true;
+                getChild<LLUICtrl>("status_text")->setValue(getString("connected_text"));
+                requestBootstrap();
+            }
+            updateControls();
+            break;
+
+        case MEDIA_EVENT_NAME_CHANGED:
+            applyPageState(self->getMediaName());
+            break;
+
+        case MEDIA_EVENT_PLUGIN_FAILED:
+        case MEDIA_EVENT_PLUGIN_FAILED_LAUNCH:
+            mPageReady = false;
+            getChild<LLUICtrl>("status_text")->setValue(getString("error_text"));
+            updateControls();
+            break;
+
+        default:
+            break;
+    }
+}
+
+void LLFloaterNLIMedia::applyPageState(const std::string& title)
+{
+    if (!boost::algorithm::starts_with(title, "NLI_MEDIA|"))
+    {
+        return;
+    }
+
+    std::vector<std::string> fields;
+    boost::split(fields, title, boost::is_any_of("|"));
+    for (const std::string& field : fields)
+    {
+        const std::string::size_type separator = field.find('=');
+        if (separator == std::string::npos)
+        {
+            continue;
+        }
+        const std::string key = field.substr(0, separator);
+        const bool value = field.substr(separator + 1) == "1";
+        if (key == "cam") sCameraOn = value;
+        else if (key == "mic") sMicrophoneOn = value;
+        else if (key == "cam_allowed") mCameraAllowed = value;
+        else if (key == "mic_allowed") mMicrophoneAllowed = value;
+    }
+
+    sCameraDesired = sCameraOn;
+    sMicrophoneDesired = sMicrophoneOn;
+    updateControls();
+}
+
+void LLFloaterNLIMedia::updateControls()
+{
+    if (!mCameraButton || !mMicrophoneButton)
+    {
+        return;
+    }
+
+    mCameraButton->setEnabled(mPageReady && mCameraAllowed);
+    mMicrophoneButton->setEnabled(mPageReady && mMicrophoneAllowed);
+    mCameraButton->setToggleState(sCameraDesired);
+    mMicrophoneButton->setToggleState(sMicrophoneDesired);
+}
+
+bool LLFloaterNLIMedia::isAllowedLocation(const std::string& url) const
+{
+    if (url.empty() || url == "about:blank")
+    {
+        return true;
+    }
+
+    const LLURI expected(gSavedSettings.getString("NewLifeItalyMediaURL"));
+    const LLURI actual(url);
+    std::string allowed_path = expected.path();
+    if (allowed_path.empty() || allowed_path.back() != '/')
+    {
+        allowed_path += '/';
+    }
+    return actual.scheme() == "https" &&
+           actual.scheme() == expected.scheme() &&
+           actual.hostName() == expected.hostName() &&
+           actual.hostPort() == expected.hostPort() &&
+           boost::algorithm::starts_with(actual.path(), allowed_path);
+}
