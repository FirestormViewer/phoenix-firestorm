<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<floater
 name="blazing_storm_remote"
 positioning="centered"
 legacy_header_height="18"
 can_resize="true"
 can_dock="false"
 can_close="true"
 height="720"
 width="640"
 min_width="520"
 min_height="480"
 layout="topleft"
 save_rect="true"
 save_visibility="true"
 single_instance="true"
 title="Blazing Storm Remote Control">

  <text
   name="status"
   layout="topleft"
   left="16"
   right="-16"
   top="28"
   height="34"
   follows="left|top|right"
   word_wrap="true">
    Idle | disconnected | not paired
  </text>

  <tab_container
   name="remote_tabs"
   layout="topleft"
   left="10"
   right="-10"
   top="70"
   bottom="-10"
   follows="all"
   tab_position="top">

    <panel
     name="subject_panel"
     label="Subject / Host"
     layout="topleft"
     follows="all"
     background_visible="true">

      <scroll_container
       name="subject_scroll"
       layout="topleft"
       left="0"
       right="-1"
       top="0"
       bottom="-1"
       follows="all"
       opaque="false"
       reserve_scroll_corner="false">

        <panel
         name="subject_content"
         layout="topleft"
         left="0"
         top="0"
         right="-15"
         min_width="480"
         height="1025"
         follows="left|top|right"
         background_visible="false">

          <text
           name="subject_intro"
           layout="topleft"
           left="16"
           right="-24"
           top="14"
           height="52"
           follows="left|top|right"
           word_wrap="true">
            The local control listener normally stays closed. A Blazing Storm request arrives first as a visible Second Life IM and briefly opens it. Requests from whitelisted controllers auto-accept; everyone else gets an Accept / Decline popup.
          </text>

          <text
           name="pairing_code_label"
           layout="topleft"
           left="16"
           top="80"
           width="105"
           height="18">
            Your avatar UUID:
          </text>

          <line_editor
           name="pairing_code"
           layout="topleft"
           left="124"
           right="-184"
           top="75"
           height="26"
           follows="left|top|right"
           enabled="false"
           select_on_focus="true" />

          <button
           name="start_host"
           label="Debug: Open Listener"
           layout="topleft"
           right="-24"
           top="75"
           width="150"
           height="26"
           follows="right|top" />

          <!-- Retained as hidden fallbacks for /blaze accept and /blaze reject. -->
          <button name="accept" label="Accept" layout="topleft" visible="false" enabled="false" left="0" top="0" width="1" height="1" />
          <button name="reject" label="Reject" layout="topleft" visible="false" enabled="false" left="0" top="0" width="1" height="1" />

          <text
           name="session_header"
           layout="topleft"
           left="16"
           top="124"
           width="280"
           height="18"
           font="SansSerifSmall"
           font.style="BOLD">
            Active possession session
          </text>

          <button
           name="disconnect"
           label="Disconnect Current Session"
           layout="topleft"
           left="16"
           top="150"
           width="190"
           height="26" />

          <button
           name="save_current_controller"
           label="Add / Update Current Controller"
           layout="topleft"
           right="-24"
           top="150"
           width="220"
           height="26"
           follows="right|top"
           tool_tip="Save the current controller and the permissions currently granted to them. Future matching requests will auto-accept." />

          <text
           name="save_current_note"
           layout="topleft"
           left="16"
           right="-24"
           top="184"
           height="34"
           word_wrap="true">
            Saving the current controller makes this controller pre-authorized for future possession requests using the permissions currently active below.
          </text>

          <text
           name="permissions_header"
           layout="topleft"
           left="16"
           top="232"
           width="300"
           height="18"
           font="SansSerifSmall"
           font.style="BOLD">
            Current controller permissions
          </text>

          <check_box
           name="allow_controller_im"
           label="Allow controller to send direct IMs as me"
           layout="topleft"
           left="16"
           top="258"
           width="360"
           height="18" />

          <check_box
           name="allow_touch"
           label="Allow controller to touch objects as me"
           layout="topleft"
           left="16"
           top="284"
           width="380"
           height="18" />

          <check_box
           name="allow_sitstand"
           label="Allow controller to sit / stand me"
           layout="topleft"
           left="16"
           top="310"
           width="380"
           height="18" />

          <check_box
           name="allow_script_dialogs"
           label="Forward relevant object blue menus to controller"
           layout="topleft"
           left="16"
           top="336"
           width="430"
           height="18"
           tool_tip="Only menus from the object/linkset just touched or sat on are forwarded." />

          <check_box
           name="allow_restrictions"
           label="Allow controller to change my movement / chat / IM restrictions"
           layout="topleft"
           left="16"
           top="362"
           width="450"
           height="18" />

          <check_box
           name="allow_full_control"
           label="FULL CONTROL - allow every Blazing Storm remote ability"
           layout="topleft"
           left="16"
           top="390"
           width="455"
           height="20"
           tool_tip="Grants all current remote permissions. Money actions are still never available." />

          <text
           name="full_control_warning"
           layout="topleft"
           left="36"
           right="-24"
           top="416"
           height="38"
           word_wrap="true">
            WARNING: Only give Full Control to someone you truly trust. This grants every current remote ability. Money actions remain unavailable.
          </text>

          <text
           name="money_note"
           layout="topleft"
           left="36"
           right="-24"
           top="466"
           height="28"
           word_wrap="true">
            Money actions are never available to the controller.
          </text>

          <text
           name="subject_restrictions_header"
           layout="topleft"
           left="16"
           top="510"
           width="300"
           height="18"
           font="SansSerifSmall"
           font.style="BOLD">
            Current subject restrictions
          </text>

          <check_box
           name="subject_restrict_movement"
           label="Block my local movement controls"
           layout="topleft"
           left="16"
           top="536"
           width="360"
           height="18" />

          <check_box
           name="subject_restrict_chat"
           label="Redirect my nearby chat into controller thoughts"
           layout="topleft"
           left="16"
           top="562"
           width="410"
           height="18" />

          <check_box
           name="subject_restrict_im"
           label="Redirect my outgoing direct IMs into controller thoughts"
           layout="topleft"
           left="16"
           top="588"
           width="450"
           height="18" />

          <text
           name="debug_header"
           layout="topleft"
           left="16"
           top="634"
           width="280"
           height="18"
           font="SansSerifSmall"
           font.style="BOLD">
            Debugging
          </text>

          <check_box
           name="disable_local_movement"
           label="Debug: disable my local movement controls while possessed"
           layout="topleft"
           left="16"
           top="660"
           width="430"
           height="18"
           tool_tip="Temporary debug option. OFF by default and reset for each session." />

          <text
           name="debug_note"
           layout="topleft"
           left="36"
           right="-24"
           top="688"
           height="42"
           word_wrap="true">
            The movement restriction above is session state. This debug checkbox is temporary and resets to OFF whenever possession starts or ends.
          </text>

          <text
           name="acceptance_messages_header"
           layout="topleft"
           left="16"
           top="752"
           width="300"
           height="18"
           font="SansSerifSmall"
           font.style="BOLD">
            Possession acceptance messages
          </text>

          <text
           name="accepted_message_label"
           layout="topleft"
           left="16"
           top="780"
           width="190"
           height="18">
            After manual acceptance:
          </text>

          <line_editor
           name="accepted_message"
           layout="topleft"
           left="16"
           right="-24"
           top="802"
           height="26"
           follows="left|top|right"
           max_length_bytes="1023"
           tool_tip="Nearby chat spoken by your avatar after you manually accept. Leave empty for no announcement." />

          <text
           name="whitelist_accepted_message_label"
           layout="topleft"
           left="16"
           top="844"
           width="220"
           height="18">
            After whitelist auto-accept:
          </text>

          <line_editor
           name="whitelist_accepted_message"
           layout="topleft"
           left="16"
           right="-24"
           top="866"
           height="26"
           follows="left|top|right"
           max_length_bytes="1023"
           tool_tip="Nearby chat spoken by your avatar when a whitelisted controller is accepted automatically. Leave empty for no announcement." />

          <text
           name="acceptance_messages_note"
           layout="topleft"
           left="16"
           right="-24"
           top="904"
           height="36"
           follows="left|top|right"
           word_wrap="true">
            These messages are saved per avatar/account. Leave either field blank if you do not want that acceptance type announced in nearby chat.
          </text>

          <button
           name="emergency_release"
           label="EMERGENCY RELEASE"
           layout="topleft"
           left="16"
           top="962"
           width="210"
           height="34"
           font="SansSerif"
           tool_tip="Immediately ends possession locally. This can never be disabled." />
        </panel>
      </scroll_container>
    </panel>

    <panel
     name="controller_panel"
     label="Controller"
     layout="topleft"
     follows="all"
     background_visible="true">

      <scroll_container
       name="controller_scroll"
       layout="topleft"
       left="0"
       right="-1"
       top="0"
       bottom="-1"
       follows="all"
       opaque="false"
       reserve_scroll_corner="false">

        <panel
         name="controller_content"
         layout="topleft"
         left="0"
         top="0"
         right="-15"
         min_width="480"
         height="820"
         follows="left|top|right"
         background_visible="false">

          <text
           name="controller_intro"
           layout="topleft"
           left="16"
           right="-24"
           top="14"
           height="48"
           follows="left|top|right"
           word_wrap="true">
            Enter the subject avatar UUID and send a possession request. Blazing Storm first sends a visible themed Second Life IM. Whitelisted controllers auto-connect; otherwise the subject gets an Accept / Decline popup.
          </text>

          <text
           name="connect_code_label"
           layout="topleft"
           left="16"
           top="76"
           width="95"
           height="18">
            Subject UUID:
          </text>

          <line_editor
           name="connect_code"
           layout="topleft"
           left="112"
           right="-164"
           top="71"
           height="26"
           follows="left|top|right"
           max_length_chars="36"
           tool_tip="UUID of the subject avatar logged into another local Blazing Storm viewer" />

          <button
           name="connect"
           label="Send Request"
           layout="topleft"
           right="-24"
           top="71"
           width="130"
           height="26"
           follows="right|top" />

          <text
           name="movement_section_header"
           layout="topleft"
           left="16"
           top="120"
           width="280"
           height="18"
           font="SansSerifSmall"
           font.style="BOLD">
            Movement
          </text>

          <text
           name="movement_mode_label"
           layout="topleft"
           left="16"
           top="150"
           width="105"
           height="18">
            Movement mode:
          </text>

          <combo_box
           name="movement_mode"
           layout="topleft"
           left="122"
           top="144"
           width="200"
           height="26"
           allow_text_entry="false">
            <combo_box.item label="Subject only" name="SubjectOnly" value="subject" />
            <combo_box.item label="Mirror both" name="MirrorBoth" value="mirror" />
            <combo_box.item label="Controller only" name="ControllerOnly" value="controller" />
          </combo_box>

          <layout_stack
           name="movement_primary_row"
           layout="topleft"
           orientation="horizontal"
           left="16"
           right="-24"
           top="194"
           height="28"
           follows="left|top|right">
            <layout_panel auto_resize="true" min_width="90">
              <button name="remote_forward" label="Forward" layout="topleft" follows="all" left="2" right="-2" top="1" height="26" />
            </layout_panel>
            <layout_panel auto_resize="true" min_width="90">
              <button name="remote_back" label="Back" layout="topleft" follows="all" left="2" right="-2" top="1" height="26" />
            </layout_panel>
            <layout_panel auto_resize="true" min_width="90">
              <button name="remote_jump" label="Jump" layout="topleft" follows="all" left="2" right="-2" top="1" height="26" />
            </layout_panel>
            <layout_panel auto_resize="true" min_width="90">
              <button name="remote_stop" label="STOP" layout="topleft" follows="all" left="2" right="-2" top="1" height="26" />
            </layout_panel>
          </layout_stack>

          <layout_stack
           name="movement_secondary_row"
           layout="topleft"
           orientation="horizontal"
           left="16"
           right="-24"
           top="228"
           height="28"
           follows="left|top|right">
            <layout_panel auto_resize="true" min_width="90">
              <button name="remote_left" label="Strafe Left" layout="topleft" follows="all" left="2" right="-2" top="1" height="26" />
            </layout_panel>
            <layout_panel auto_resize="true" min_width="90">
              <button name="remote_right" label="Strafe Right" layout="topleft" follows="all" left="2" right="-2" top="1" height="26" />
            </layout_panel>
            <layout_panel auto_resize="true" min_width="90">
              <button name="remote_turn_left" label="Turn Left" layout="topleft" follows="all" left="2" right="-2" top="1" height="26" />
            </layout_panel>
            <layout_panel auto_resize="true" min_width="90">
              <button name="remote_turn_right" label="Turn Right" layout="topleft" follows="all" left="2" right="-2" top="1" height="26" />
            </layout_panel>
          </layout_stack>

          <layout_stack
           name="movement_flight_row"
           layout="topleft"
           orientation="horizontal"
           left="16"
           right="-24"
           top="262"
           height="28"
           follows="left|top|right">
            <layout_panel auto_resize="true" min_width="100">
              <button name="remote_fly" label="Fly" layout="topleft" follows="all" left="2" right="-2" top="1" height="26" />
            </layout_panel>
            <layout_panel auto_resize="true" min_width="100">
              <button name="remote_land" label="Land" layout="topleft" follows="all" left="2" right="-2" top="1" height="26" />
            </layout_panel>
            <layout_panel auto_resize="true" min_width="100">
              <button name="remote_crouch" label="Crouch / Down" layout="topleft" follows="all" left="2" right="-2" top="1" height="26" />
            </layout_panel>
          </layout_stack>

          <text
           name="movement_note"
           layout="topleft"
           left="16"
           right="-24"
           top="304"
           height="42"
           follows="left|top|right"
           word_wrap="true">
            Normal movement, vertical movement, fly toggles, and these buttons follow this mode while paired. Subject only moves the subject; Mirror both moves both avatars; Controller only moves you.
          </text>

          <text
           name="nearby_header"
           layout="topleft"
           left="16"
           top="364"
           width="280"
           height="18"
           font="SansSerifSmall"
           font.style="BOLD">
            Speak as subject
          </text>

          <line_editor
           name="remote_say_text"
           layout="topleft"
           left="16"
           right="-146"
           top="390"
           height="26"
           follows="left|top|right"
           max_length_bytes="1023" />

          <button
           name="remote_say"
           label="Send Nearby"
           layout="topleft"
           right="-24"
           top="390"
           width="112"
           height="26"
           follows="right|top" />

          <text
           name="im_header"
           layout="topleft"
           left="16"
           top="438"
           width="280"
           height="18"
           font="SansSerifSmall"
           font.style="BOLD">
            Direct IM as subject
          </text>

          <text
           name="im_target_label"
           layout="topleft"
           left="16"
           top="466"
           width="90"
           height="18">
            Target UUID:
          </text>

          <line_editor
           name="remote_im_target"
           layout="topleft"
           left="110"
           right="-24"
           top="461"
           height="26"
           follows="left|top|right"
           max_length_chars="36"
           tool_tip="Target avatar UUID" />

          <line_editor
           name="remote_im_text"
           layout="topleft"
           left="16"
           right="-146"
           top="497"
           height="26"
           follows="left|top|right"
           max_length_bytes="1023" />

          <button
           name="remote_im"
           label="Send IM"
           layout="topleft"
           right="-24"
           top="497"
           width="112"
           height="26"
           follows="right|top" />

          <text
           name="controller_restrictions_header"
           layout="topleft"
           left="16"
           top="548"
           width="280"
           height="18"
           font="SansSerifSmall"
           font.style="BOLD">
            Subject restrictions
          </text>

          <check_box
           name="remote_restrict_movement"
           label="Block subject local movement"
           layout="topleft"
           left="16"
           top="576"
           width="300"
           height="18" />

          <check_box
           name="remote_restrict_chat"
           label="Restrict subject nearby chat"
           layout="topleft"
           left="16"
           top="602"
           width="300"
           height="18" />

          <check_box
           name="remote_restrict_im"
           label="Restrict subject outgoing IMs"
           layout="topleft"
           left="16"
           top="628"
           width="300"
           height="18" />

          <text
           name="session_end_header"
           layout="topleft"
           left="16"
           top="678"
           width="280"
           height="18"
           font="SansSerifSmall"
           font.style="BOLD">
            Session
          </text>

          <button
           name="remote_stand"
           label="Stand Subject"
           layout="topleft"
           left="16"
           top="706"
           width="155"
           height="30"
           tool_tip="Make the possessed avatar stand up" />

          <button
           name="remote_release"
           label="End Possession"
           layout="topleft"
           left="181"
           top="706"
           width="155"
           height="30" />
        </panel>
      </scroll_container>
    </panel>

    <panel
     name="trusted_panel"
     label="Trusted Controllers"
     layout="topleft"
     follows="all"
     background_visible="true">

      <scroll_container
       name="trusted_scroll"
       layout="topleft"
       left="0"
       right="-1"
       top="0"
       bottom="-1"
       follows="all"
       opaque="false"
       reserve_scroll_corner="false">

        <panel
         name="trusted_content"
         layout="topleft"
         left="0"
         top="0"
         right="-15"
         min_width="480"
         height="820"
         follows="left|top|right"
         background_visible="false">

          <text
           name="trusted_intro"
           layout="topleft"
           left="16"
           right="-24"
           top="14"
           height="54"
           follows="left|top|right"
           word_wrap="true">
            Controllers saved here are pre-authorized. A matching possession request will auto-accept and apply this saved permission profile without showing the Accept / Decline popup.
          </text>

          <text
           name="trusted_list_label"
           layout="topleft"
           left="16"
           top="84"
           width="150"
           height="18">
            Whitelisted controller:
          </text>

          <combo_box
           name="trusted_controller_list"
           layout="topleft"
           left="16"
           right="-196"
           top="108"
           height="26"
           follows="left|top|right"
           allow_text_entry="false" />

          <button
           name="trusted_new"
           label="New"
           layout="topleft"
           right="-108"
           top="108"
           width="76"
           height="26"
           follows="right|top" />

          <button
           name="trusted_remove"
           label="Remove"
           layout="topleft"
           right="-24"
           top="108"
           width="76"
           height="26"
           follows="right|top" />

          <text
           name="trusted_id_label"
           layout="topleft"
           left="16"
           top="158"
           width="100"
           height="18">
            Avatar UUID:
          </text>

          <line_editor
           name="trusted_avatar_id"
           layout="topleft"
           left="122"
           right="-24"
           top="153"
           height="26"
           follows="left|top|right"
           max_length_chars="36" />

          <text
           name="trusted_name_label"
           layout="topleft"
           left="16"
           top="196"
           width="100"
           height="18">
            Display name:
          </text>

          <line_editor
           name="trusted_avatar_name"
           layout="topleft"
           left="122"
           right="-24"
           top="191"
           height="26"
           follows="left|top|right"
           max_length_chars="128" />

          <text
           name="trusted_permissions_header"
           layout="topleft"
           left="16"
           top="238"
           width="320"
           height="18"
           font="SansSerifSmall"
           font.style="BOLD">
            Auto-accepted permissions
          </text>

          <check_box
           name="trusted_movement"
           label="Control movement"
           layout="topleft"
           left="16"
           top="266"
           width="300"
           height="18" />

          <check_box
           name="trusted_chat"
           label="Speak in nearby chat as me"
           layout="topleft"
           left="16"
           top="294"
           width="300"
           height="18" />

          <check_box
           name="trusted_im"
           label="Send direct IMs as me"
           layout="topleft"
           left="16"
           top="322"
           width="300"
           height="18" />

          <check_box
           name="trusted_touch"
           label="Touch objects as me"
           layout="topleft"
           left="16"
           top="350"
           width="300"
           height="18" />

          <check_box
           name="trusted_sitstand"
           label="Sit / stand me"
           layout="topleft"
           left="16"
           top="378"
           width="300"
           height="18" />

          <check_box
           name="trusted_dialogs"
           label="Receive and answer relevant object blue menus"
           layout="topleft"
           left="16"
           top="406"
           width="420"
           height="18" />

          <check_box
           name="trusted_restrictions"
           label="Change my movement / chat / IM restrictions"
           layout="topleft"
           left="16"
           top="434"
           width="410"
           height="18" />

          <text
           name="trusted_note"
           layout="topleft"
           left="16"
           right="-24"
           top="616"
           height="64"
           follows="left|top|right"
           word_wrap="true">
            Removing a controller restores normal request approval. Object touch, sit/stand, menus, camera, direct IM, and restriction control remain off unless explicitly granted.
          </text>

          <check_box name="trusted_camera" label="Control my camera"
           layout="topleft" left="16" top="462" width="410" height="18" />
          <check_box name="trusted_inventory" label="Inventory: browse, dress, and rez copies"
           layout="topleft" left="16" top="484" width="450" height="18" />
          <check_box name="trusted_teleport" label="Teleport: travel, send and answer offers"
