	<menu_item_separator
	 layout="topleft"/>
	<menu_item_call
	 label="Delete"
	 layout="topleft"
	 name="delete">
		<menu_item_call.on_click
		 function="CameraBookmark.Action"
		 parameter="delete"/>
		<menu_item_call.on_enable
		 function="CameraBookmark.Enable"
		 parameter="delete"/>
	</menu_item_call>
</context_menu>
