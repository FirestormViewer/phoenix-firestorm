<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<panel label="Kontrolery gier" name="game_control_panel">
	<tab_container name="game_control_tabs">
		<panel label="Przypisania akcji" name="tab_action_mappings">
			<combo_box name="action_mode" tool_tip="Wybierz tryb, aby edytować jego przypisania.">
				<combo_box.item label="Podczas poruszania awatarem" name="avatar" />
				<combo_box.item label="W trybie pierwszoosobowym" name="mouselook" />
				<combo_box.item label="W trybie wolnej kamery" name="flycam" />
				<combo_box.item label="Siedząc" name="captive" />
				<combo_box.item label="W trybie kursora myszy" name="cursor" />
			</combo_box>
			<check_box label="Tryb włączony" name="action_mode_enabled" tool_tip="Odznacz, aby zablokować przypisania tego trybu i przestać zamieniać sygnały z kontrolera gier na akcje tego trybu." width="105" />
			<check_box label="Zezwól na przechył" name="flycam_allow_roll" tool_tip="Pozwala, by przechył obracał wolną kamerę wokół jej osi przód-tył. Widoczne tylko podczas edycji przypisań wolnej kamery." width="130" />
			<text name="speed_slow_label" width="38">
				Wolno
			</text>
			<slider name="speed_factor" tool_tip="Wolna kamera: prędkość ruchu kamery. Tryb pierwszoosobowy: prędkość obracania i rozglądania się. Awatar: prędkość obracania. Widoczne tylko podczas edycji przypisań wolnej kamery, trybu pierwszoosobowego lub awatara." width="62" />
			<text name="speed_fast_label" width="44">
				Szybko
			</text>
			<check_box label="Ukryj kursor myszy" name="flycam_hide_cursor" tool_tip="Ukrywa kursor myszy podczas latania wolną kamerą. Kursor pojawia się znowu po poruszeniu myszą i znika ponownie po 5 sekundach albo w ciągu 1 sekundy od chwili, gdy wolna kamera ruszy. Widoczne tylko podczas edycji przypisań wolnej kamery." width="135" />
			<check_box label="Pokaż celownik" name="flycam_crosshair" tool_tip="Rysuje celownik na środku ekranu podczas latania wolną kamerą. Widoczne tylko podczas edycji przypisań wolnej kamery." />
			<button label="Przywróć domyślne" name="restore_actions_defaults" tool_tip="Przywraca domyślne przypisania akcji dla bieżącego trybu." />
			<text name="current_mode_indicator">
				Aktywny tryb:
			</text>
			<panel name="action_mappings_panel">
				<panel name="action_mappings_axes_panel">
					<scroll_list name="action_mappings_axes">
						<scroll_list.columns label="Akcja" name="action" />
						<scroll_list.columns label="Wejście" name="input" />
						<scroll_list.columns label="Oś" name="input_description" />
						<scroll_list.columns label="Odwróć" name="invert" />
					</scroll_list>
				</panel>
				<panel name="action_mappings_buttons_panel">
					<scroll_list name="action_mappings_buttons">
						<scroll_list.columns label="Akcja" name="action" />
						<scroll_list.columns label="Wejście" name="input" />
						<scroll_list.columns label="Przycisk" name="input_description" />
					</scroll_list>
				</panel>
			</panel>
		</panel>
		<panel label="Przypisania urządzeń" name="tab_device_mappings">
			<text name="nodevice_message">
				Brak urządzenia
			</text>
			<check_box label="Pokaż wszystkie znane urządzenia" name="show_all_known_devices" left="85" width="230" />
			<text name="device_prompt" width="72">
				Urządzenie:
			</text>
			<combo_box name="device_list" left="85" />
			<button label="Przywróć domyślne" name="restore_device_defaults" tool_tip="Przywraca domyślne ustawienia wybranego urządzenia." />
			<panel name="device_settings">
				<panel name="axis_channels_panel">
					<scroll_list name="axis_channels">
						<scroll_list.columns label="Co naciskasz" name="input_description" />
						<scroll_list.columns label="Co otrzymujesz" name="output_description" />
					</scroll_list>
				</panel>
				<panel name="button_channels_panel">
					<scroll_list name="button_channels">
						<scroll_list.columns label="Co naciskasz" name="input_description" />
						<scroll_list.columns label="Co otrzymujesz" name="output_description" />
					</scroll_list>
				</panel>
			</panel>
		</panel>
		<panel label="Opcje urządzeń" name="tab_device_options">
			<text name="state_nodevice_message">
				Brak urządzenia
			</text>
			<text name="state_device_prompt" width="72">
				Urządzenie:
			</text>
			<combo_box name="options_device_list" left="85" />
			<button label="Przywróć domyślne" name="restore_device_options_defaults" tool_tip="Przywraca domyślne przesunięcie, odwrócenie i tolerancję (martwą strefę) dla każdej osi wybranego urządzenia." />
			<button label="Autokalibracja" name="auto_calibrate" tool_tip="Próbkuje surowe osie wybranego urządzenia przez 5 klatek. Każda oś, która się nie porusza, jest uznawana za będącą w spoczynku, a jej przesunięcie i tolerancja są ustawiane na podstawie tego odczytu." />
			<panel name="device_state_settings">
				<panel name="axis_state_panel">
					<scroll_list name="axis_state">
						<scroll_list.columns label="Wejście" name="input_glyph" />
						<scroll_list.columns label="Oś" name="input" relative_width="0.20" />
						<scroll_list.columns label="Surowa" name="raw_value" relative_width="0.12" />
						<scroll_list.columns label="Przesun." name="offset" relative_width="0.12" />
						<scroll_list.columns label="Odwróć" name="invert" relative_width="0.11" />
						<scroll_list.columns label="Tolerancja" name="dead_zone" relative_width="0.14" />
						<scroll_list.columns label="Skorygowana" name="fixed_value" relative_width="0.19" />
					</scroll_list>
				</panel>
				<panel name="button_state_panel">
					<scroll_list name="button_state">
						<scroll_list.columns label="Wejście" name="input_glyph" />
						<scroll_list.columns label="Przycisk" name="input" />
						<scroll_list.columns label="Wartość" name="value" />
					</scroll_list>
				</panel>
			</panel>
		</panel>
		<panel label="Dane dla serwera" name="tab_server_data">
			<check_box label="Wysyłaj dane GameControl na serwer" name="game_control_to_server" width="250" />
			<text name="data_note">
				Dane wysyłane na serwer: osie i przyciski kanoniczne, a po nich osie i przyciski semantyczne bieżącego trybu.
			</text>
			<panel name="data_panel">
				<scroll_list name="data_output">
					<scroll_list.columns label="Nazwa" name="output" />
					<scroll_list.columns label="Wartość" name="value" />
				</scroll_list>
			</panel>
		</panel>
	</tab_container>
