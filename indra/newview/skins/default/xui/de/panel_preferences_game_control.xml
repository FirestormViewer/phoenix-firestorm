<?xml version="1.0" encoding="utf-8"?>
<panel label="Spiel-Kontrollen" name="game_control_panel">
    <tab_container name="game_control_tabs">
        <panel name="tab_action_mappings" label="Aktionszuordnungen">
            <combo_box name="action_mode" tool_tip="Modus zum Editieren der Zuordnungen auswählen.">
                <combo_box.item label="Beim Bewegen des Avatars" name="avatar"/>
                <combo_box.item label="Wenn in 1. Person (Mouselook)" name="mouselook"/>
                <combo_box.item label="Beim Bewegen der Flugkamera" name="flycam"/>
                <combo_box.item label="Beim Sitzen" name="captive"/>
                <combo_box.item label="Beim Bewegen des Mauszeigers" name="cursor"/>
            </combo_box>
            <check_box name="action_mode_enabled" label="Modus aktiviert" tool_tip="Deaktivieren um diese Zuordnungen zu sperren und die Konvertierung von Eingaben der Spielkontrollen auf die Aktionen dieses Modus zu stoppen."/>
            <check_box name="flycam_allow_roll" label="Rollen erlauben" tool_tip="Erlaubt der Eingabe von Rollbewegungen die Flugkamera um die Vorwärtsachse zu drehen. Wird nur angezeigt während Zuordnungen der Flugkamera bearbeitet werden."/>
            <text name="speed_slow_label" width="40">
                Langs.
            </text>
            <slider name="speed_factor" width="69" tool_tip="Flugkamera: Geschwindigkeit der Kamerabewegung. Mouselook: Geschwindigkeit drehen/schauen. Avatar: Geschwindigkeit drehen. Wird nur angezeigt während Zuordnungen der Flugkamera oder des Avatars bearbeitet werden."/>
            <text name="speed_fast_label" width="45">
                Schnell
            </text>
            <check_box name="flycam_hide_cursor" label="Mauszeiger verst." tool_tip="Versteckt den Mauszeiger während des Fliegens mit der Flugkamera. Er wird wieder angezeigt, wenn die Maus bewegt wird und wird 5 Sekunden später wieder versteckt oder nach einer Sekunde, wenn die Flugkamera bewegt wird. Only shown while editing FlyCam mappings. Wird nur angezeigt während Zuordnungen der Flugkamera bearbeitet werden."/>
            <check_box name="flycam_crosshair" label="Fadenkreuz anzeigen" tool_tip="Zeichnet ein Fadenkreuz in der Mitte des Bildschirms während des Fliegens mit der Flugkamera. Wird nur angezeigt während Zuordnungen der Flugkamera bearbeitet werden."/>
            <button name="restore_actions_defaults" label="Standard wiederherst." tool_tip="Stellt die Standzuordnungen fpr den aktuellen Modus wieder her."/>
            <text name="current_mode_indicator">
                Aktiver Modus:
            </text>
            <panel name="action_mappings_panel">
                <panel name="action_mappings_axes_panel">
                    <scroll_list name="action_mappings_axes">
                        <scroll_list.columns name="action" label="Aktion"/>
                        <scroll_list.columns name="input" label="Eingabe"/>
                        <scroll_list.columns name="input_description" label="Achse"/>
                        <scroll_list.columns name="invert" label="Invertiert"/>
                    </scroll_list>
                </panel>
                <panel name="action_mappings_buttons_panel">
                    <scroll_list name="action_mappings_buttons">
                        <scroll_list.columns name="action" label="Aktion"/>
                        <scroll_list.columns name="input" label="Eingabe"/>
                        <scroll_list.columns name="input_description" label="Knopf"/>
                    </scroll_list>
                </panel>
            </panel>
        </panel>
        <panel name="tab_device_mappings" label="Geräte-Zuordnungen">
            <text name="nodevice_message">
                Kein Gerät
            </text>
            <check_box name="show_all_known_devices" label="Alle bekannten Geräte anzeigen"/>
            <text name="device_prompt">
                Gerät:
            </text>
            <button name="restore_device_defaults" label="Standard wiederherst." tool_tip="Stellt die Standardeinstellungen des ausgewählten Geräts wieder her."/>
            <panel name="device_settings">
                <panel name="axis_channels_panel">
                    <scroll_list name="axis_channels">
                        <scroll_list.columns name="input_description" label="Was Sie drücken"/>
                        <scroll_list.columns name="output_description" label="Was Sie bekommen"/>
                    </scroll_list>
                </panel>
                <panel name="button_channels_panel">
                    <scroll_list name="button_channels">
                        <scroll_list.columns name="input_description" label="Was Sie drücken"/>
                        <scroll_list.columns name="output_description" label="Was Sie bekommen"/>
                    </scroll_list>
                </panel>
            </panel>
        </panel>
        <panel name="tab_device_options" label="Geräte-Optionen">
            <text name="state_nodevice_message">
                Kein Gerät
            </text>
            <text name="state_device_prompt">
                Gerät:
            </text>
            <button name="restore_device_options_defaults" label="Standard wiederherst." tool_tip="Stellt den Standard für Versatz, Invertierung und Todeszone für jede Achse des ausgewählten Geräts wieder her."/>
            <button name="auto_calibrate" label="Auto-Kalibrierung" tool_tip="Tastet die Roh-Achsen des Gerät über 5 Frames ab; Jede Achse, die nicht bewegt wird, wird als in der Ruhestellung angenommen und dessen Versatz und Todeszone wird anhand der ausgelesenen Werte ermittelt."/>
            <panel name="device_state_settings">
                <panel name="axis_state_panel">
                    <scroll_list name="axis_state">
                        <scroll_list.columns name="input_glyph" label="Eingabe"/>
                        <scroll_list.columns name="input"       label="Achse"/>
                        <scroll_list.columns name="raw_value"   label="Roh-Wert"/>
                        <scroll_list.columns name="offset"      label="Versatz"/>
                        <scroll_list.columns name="invert"      label="Invertiert"/>
                        <scroll_list.columns name="dead_zone"   label="Todeszone"/>
                        <scroll_list.columns name="fixed_value" label="Angepasster Wert"/>
                    </scroll_list>
                </panel>
                <panel name="button_state_panel">
                    <scroll_list name="button_state">
                        <scroll_list.columns name="input_glyph" label="Eingabe"/>
                        <scroll_list.columns name="input"       label="Knopf"/>
                        <scroll_list.columns name="value"       label="Wert"/>
                    </scroll_list>
                </panel>
            </panel>
        </panel>
        <panel name="tab_server_data" label="Server-Daten">
            <check_box name="game_control_to_server" label="Spiel-Kontroll-Daten an Server senden"/>
            <text name="data_note">
                Daten, die an den Server gesendet werden: kanonische Achsen/Knöpfe, dann die semantischen Achsen/Knöpfe des aktuellen Modus.
            </text>
            <panel name="data_panel">
                <scroll_list name="data_output">
                    <scroll_list.columns name="output" label="Name"/>
                    <scroll_list.columns name="value"  label="Wert"/>
                </scroll_list>
            </panel>
        </panel>
    </tab_container>
