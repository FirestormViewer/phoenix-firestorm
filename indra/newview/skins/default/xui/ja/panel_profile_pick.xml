<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel name="panel_pick_info">
	<panel.string name="location_notice">
		（保存後に更新されます）
	</panel.string>
	<layout_stack name="main_pick_stack">
		<layout_panel name="main_pick_lp">
			<text name="title_label">
				タイトル：
			</text>
			<text name="description_label">
				説明：
			</text>
			<!-- [AS:chanayane] Preview button -->
			<button tool_tip="選択した説明のプレビューを切り替えます。" name="btn_preview"/>
			<!-- [/AS:chanayane] -->
			<text name="location_label">
				場所：
			</text>
			<line_editor name="pick_location">
				読み込んでいます…
			</line_editor>
		</layout_panel>
		<layout_panel name="util_buttons_lp">
			<layout_stack name="util_buttons_stack">
				<layout_panel name="map_btn_lp">
					<button label="マップ上に表示" name="show_on_map_btn"/>
				</layout_panel>
				<layout_panel name="tp_btn_lp">
					<button label="テレポート" name="teleport_btn"/>
				</layout_panel>
				<layout_panel name="set_to_curr_location_btn_lp">
					<button label="場所をセット" tool_tip="現在の場所をセットします。" name="set_to_curr_location_btn"/>
				</layout_panel>
			</layout_stack>
		</layout_panel>
		<layout_panel name="save_changes_lp">
			<layout_stack name="save_changes_stack">
				<layout_panel name="create_btn_lp">
					<button label="ピック作成" name="create_changes_btn"/>
				</layout_panel>
				<layout_panel name="save_btn_lp">
					<button label="ピックを保存" name="save_changes_btn"/>
				</layout_panel>
				<layout_panel name="cancel_btn_lp">
					<button label="キャンセル" name="cancel_changes_btn"/>
				</layout_panel>
			</layout_stack>
		</layout_panel>
	</layout_stack>
</panel>
