<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater title="サウンド" name="sound_explorer">
	<floater.string name="Playing">
		再生中
	</floater.string>
	<floater.string name="NotPlaying">
		[TIME]分前
	</floater.string>
	<floater.string name="Type_UI">
		ＵＩ
	</floater.string>
	<floater.string name="Type_Avatar">
		アバター
	</floater.string>
	<check_box label="アバター" name="avatars_chk"/>
	<check_box label="オブジェクト" name="objects_chk"/>
	<check_box label="既定の衝突音" name="collision_chk" left_delta="96"/>
	<check_box label="繰り返し再生" name="repeated_asset_chk" left_delta="128"/>
	<check_box label="ログ取得一時停止" name="pause_chk"/>
