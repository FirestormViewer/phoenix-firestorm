<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater title="取引ログ" name="money_tracker">
	<name_list name="payment_list">
		<name_list.columns label="時間" name="time" />
		<name_list.columns label="名前" name="name" />
		<name_list.columns label="金額" name="amount" />
	</name_list>
	<text name="summary">
		支払ったL$ [PAID]－受け取ったL$ [RECEIVED]
	</text>
	<check_box label="閉じている時も記録" tool_tip="入金記録のウィンドウが閉じている場合でも、常に入金を記録するようにします。" name="FSAlwaysTrackPayments" />
	<button label="クリア" name="Clear" />
</floater>
