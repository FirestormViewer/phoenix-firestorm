<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater title="シーン読み込みの統計情報" name="Scene Load Statistics">
	<scroll_container name="statistics_scroll">
		<container_view name="statistics_view">
			<stat_view label="基本統計" name="basic">
				<stat_bar label="フレームごとのピクセル差" unit_label="％" name="frame difference"/>
				<stat_bar label="ＵＤＰデータの受信量" name="bandwidth"/>
				<stat_bar label="パケットロス" unit_label="％" name="packet_loss"/>
			</stat_view>
			<stat_view label="高度な統計" name="advanced">
				<stat_view label="描画" name="render">
					<stat_bar label="オブジェクト合計" name="objs"/>
					<stat_bar label="新しいオブジェクト" unit_label="／秒" name="newobjs"/>
					<stat_bar label="オブジェクトのキャッシュのヒット率" unit_label="％" name="object_cache_hits"/>
				</stat_view>
				<stat_view label="テクスチャ" name="texture">
					<stat_bar label="キャッシュヒット率" unit_label="％" name="texture_cache_hits"/>
					<stat_bar label="キャッシュ読み込み遅延量" unit_label="秒" name="texture_cache_read_latency"/>
					<stat_bar label="キャッシュデコード遅延量" unit_label="秒" name="texture_decode_latency"/>
					<stat_bar label="キャッシュ書き込み遅延量" unit_label="秒" name="texture_write_latency"/>
					<stat_bar label="キャッシュ取得遅延量" unit_label="秒" name="texture_fetch_latency"/>
					<stat_bar label="キャッシュ取得時間" unit_label="秒" name="texture_fetch_time"/>
					<stat_bar label="カウント" name="numimagesstat"/>
					<stat_bar label="Rawカウント" name="numrawimagesstat"/>
				</stat_view>
				<stat_view label="ネットワーク" name="network">
					<stat_bar label="受信パケット量" unit_label="／秒" name="packetsinstat"/>
					<stat_bar label="送信パケット量" unit_label="／秒" name="packetsoutstat"/>
					<stat_bar label="オブジェクト" unit_label="kbps" name="objectdatareceived"/>
					<stat_bar label="テクスチャ" unit_label="kbps" name="texturedatareceived"/>
					<stat_bar label="アセット" unit_label="kbps" name="assetudpdatareceived"/>
					<stat_bar label="レイヤー" unit_label="kbps" name="layersdatareceived"/>
					<stat_bar label="実効受信量" unit_label="kbps" name="messagedatain"/>
					<stat_bar label="実効送信量" unit_label="kbps" name="messagedataout"/>
				</stat_view>
			</stat_view>
			<stat_view label="シミュレーター" name="sim">
				<stat_bar label="オブジェクト" name="simobjects"/>
				<stat_bar label="アクティブなオブジェクト" name="simactiveobjects"/>
				<stat_bar label="アクティブなスクリプト" name="simactivescripts"/>
				<stat_bar label="受信パケット" unit_label="pps" name="siminpps"/>
				<stat_bar label="送信パケット" unit_label="pps" name="simoutpps"/>
				<stat_bar label="保留中のダウンロード" name="simpendingdownloads"/>
				<stat_bar label="保留中のアップロード" name="simpendinguploads"/>
				<stat_bar label="未確認バイトの合計" unit_label="㎅" name="simtotalunackedbytes"/>
				<stat_view label="時間（㎳）" name="simperf">
					<stat_bar label="合計フレーム時間" unit_label="㎳" name="simframemsec"/>
					<stat_bar label="ネット時間" unit_label="㎳" name="simnetmsec"/>
					<stat_bar label="物理作用時間" unit_label="㎳" name="simsimphysicsmsec"/>
					<stat_bar label="シミュレーション時間" unit_label="㎳" name="simsimothermsec"/>
					<stat_bar label="エージェント時間" unit_label="㎳" name="simagentmsec"/>
					<stat_bar label="イメージ時間" unit_label="㎳" name="simimagesmsec"/>
					<stat_bar label="スクリプト時間" unit_label="㎳" name="simscriptmsec"/>
					<stat_bar label="スペア時間" unit_label="㎳" name="simsparemsec"/>
					<stat_view label="時間詳細（㎳）" name="timedetails">
						<stat_bar label="　物理作用単位" unit_label="㎳" name="simsimphysicsstepmsec"/>
						<stat_bar label="　物理形状更新" unit_label="㎳" name="simsimphysicsshapeupdatemsec"/>
						<stat_bar label="　他の物理作用" unit_label="㎳" name="simsimphysicsothermsec"/>
						<stat_bar label="　スリープ時間" unit_label="㎳" name="simsleepmsec"/>
						<stat_bar label="　ポンプＩ／Ｏ" unit_label="㎳" name="simpumpiomsec"/>
					</stat_view>
				</stat_view>
			</stat_view>
			<stat_view label="フレームの内訳" name="frame_stats">
				<stat_bar label="景色" unit_label="％" name="scenery_frame_pct"/>
				<stat_bar label="アバター" unit_label="％" name="avatar_frame_pct"/>
				<stat_bar label="ＵＩ" unit_label="％" name="ui_frame_pct"/>
				<stat_bar label="ＨＵＤ" unit_label="％" name="huds_frame_pct"/>
				<stat_bar label="スワップ" unit_label="％" name="swap_frame_pct"/>
				<stat_bar label="タスク" unit_label="％" name="idle_frame_pct"/>
			</stat_view>
		</container_view>
	</scroll_container>
</floater>
