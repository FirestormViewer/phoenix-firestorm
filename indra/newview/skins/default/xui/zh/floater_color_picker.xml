<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater name="ColorPicker" title="顏色挑選器">
	<tab_container name="scale_type_container">
		<panel name="RGB">
			<text name="r_val_text">
				紅色：
			</text>
			<text name="g_val_text">
				綠色：
			</text>
			<text name="b_val_text">
				藍色：
			</text>
		</panel>
		<panel name="LSL">
			<text name="r_val_text_lsl">
				紅色:
			</text>
			<text name="g_val_text_lsl">
				綠色:
			</text>
			<text name="b_val_text_lsl">
				藍色:
			</text>
		</panel>
		<panel name="Hex">
			<text name="hex_text">
				代碼 (#rrggbb):
			</text>
		</panel>
	</tab_container>
	<text name="h_val_text">
		色調：
	</text>
	<text name="s_val_text">
		飽和度：
	</text>
	<text name="l_val_text">
		亮度：
	</text>
	<check_box label="立即應用" name="apply_immediate" />
	<combo_box name="copy_color_combobox" tool_tip="以不同格式複製顏色值。">
		<combo_box.item label="複製為..." name="copy_as" />
		<combo_box.item label="LSL" name="lsl_color" />
		<combo_box.item label="HEX" name="hex_color" />
		<combo_box.item label="RGB" name="rgb_color" />
		<combo_box.item label="HSL" name="hsl_color" />
		<combo_box.item label="CMYK" name="cmyk_color" />
	</combo_box>
	<button label="確定" label_selected="確定" name="select_btn" />
	<button label="取消" label_selected="取消" name="cancel_btn" />
	<text name="Current color:">
		當前顏色：
	</text>
	<text name="(Drag below to save.)">
		（拖拽到下方即可儲存）
	</text>
</floater>